# OverWrite 游戏引擎 — 编辑器配置
# 顶层配置文件

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,hpp,h,inl}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,cmake,txt,sh}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[CMakeLists.txt]
indent_style = space
indent_size = 4
